# ─── Convex Database ───────────────────────────────────────────
# Get from: https://dashboard.convex.dev → Your Project → Settings
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ─── Clerk Authentication ───────────────────────────────────────
# Get from: https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk URLs (defaults below work for standard setup)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Disable bot protection for development
CLERK_DISABLE_BOT_PROTECTION=true

# ─── Groq AI ────────────────────────────────────────────────────
# Get from: https://console.groq.com → API Keys
GROQ_API_KEY=
# Groq model identifier for AI code explanation and fix generation
GROQ_MODEL=openai/gpt-oss-120b
